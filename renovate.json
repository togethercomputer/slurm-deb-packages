{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "every 6 hours every weekday"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "workflow-actions"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "base-images"
    }
  ]
}
